{
  "name": "@bxshefby/b24jssdk-nuxt",
  "version": "3.2.0",
  "author": "ООО «БэИксШефБай»",
  "license": "MIT",
  "description": "Bitrix24 REST API JS SDK for Nuxt",
  "keywords": [
    "bitrix24",
    "restapi",
    "nuxt"
  ],
  "homepage": "https://github.com/bx-shef/b24-js-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bx-shef/b24-js-sdk.git",
    "directory": "packages/jssdk-nuxt"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./runtime/*": "./dist/runtime/*"
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/module.d.mts"
      ],
      "runtime/*": [
        "./dist/runtime/*"
      ]
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "scripts": {
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare",
    "prepack": "pnpm build",
    "build": "nuxt-module-build build",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@bxshefby/b24jssdk": "workspace:*",
    "@nuxt/kit": "^4.5.2"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.4",
    "@nuxt/module-builder": "^1.0.4",
    "@nuxt/schema": "^4.5.2",
    "@types/node": "^26.6.6",
    "nuxt": "^4.5.2",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vue-tsc": "^3.3.14"
  }
}
