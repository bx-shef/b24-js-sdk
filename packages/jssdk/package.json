{
  "name": "@bxshefby/b24jssdk",
  "version": "3.1.0",
  "author": "ООО «БэИксШефБай»",
  "license": "MIT",
  "description": "Bitrix24 REST API JavaScript SDK",
  "keywords": [
    "bitrix24",
    "js",
    "typescript",
    "javascript",
    "nodejs",
    "sdk",
    "rest-api",
    "api",
    "client"
  ],
  "homepage": "https://github.com/bx-shef/b24-js-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bx-shef/b24-js-sdk.git",
    "directory": "packages/jssdk"
  },
  "bugs": {
    "url": "https://github.com/bx-shef/b24-js-sdk/issues"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      },
      "default": "./dist/esm/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/esm/index.d.ts",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/esm/index.d.ts"
      ]
    }
  },
  "unpkg": "./dist/umd/index.min.js",
  "jsdelivr": "./dist/umd/index.min.js",
  "files": [
    "dist/**",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/*.map",
    "!dist/esm/index.d.mts",
    "!dist/cjs/index.d.ts",
    "!dist/cjs/index.d.mts",
    "!dist/umd/index.js",
    "README.md",
    "README-AI.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "unbuild --stub",
    "dev:prepare": "pnpm run build",
    "build": "unbuild",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@types/luxon": "^3.7.6",
    "axios": "catalog:",
    "luxon": "^3.7.2",
    "qs-esm": "^8.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1"
  }
}
