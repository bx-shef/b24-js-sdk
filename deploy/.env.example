# Домен сайта документации (DNS A-запись — на этот сервер). Тот же адрес (https://…) — секрет
# репозитория DOCS_SITE_URL для сборки образа: sitemap, canonical, og.
DOMAIN=
LETSENCRYPT_EMAIL=
# Чат помощника на DeepSeek: ключ и включатель. Ключ только здесь, в образ он не попадает.
DEEPSEEK_API_KEY=
ASSISTANT_ENABLED=false
# Лимиты чата: запросов в минуту с одного клиента и всего за сутки (расход ключа).
ASSISTANT_RATE_PER_MINUTE=20
ASSISTANT_DAILY_LIMIT=2000
# Номер Яндекс Метрики вшит в образ (секрет репозитория YANDEX_METRIKA_ID); здесь не задаётся.
